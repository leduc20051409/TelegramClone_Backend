# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/telegram_clone
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Configuration (Secret key should be 256-bit hexadecimal string)
JWT_SECRET=your_jwt_secret_key_should_be_at_least_256_bits_long
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Configuration (Use Gmail App Password)
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password
